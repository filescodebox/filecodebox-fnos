#!/bin/bash
# PigeonBox 飞牛(fnOS)应用生命周期脚本(原生进程模式,v1.2.7 起)
#
# v1.2.6 及以前为 Docker 项目模式(resource: docker-project + ghcr 镜像),
# 真机回归暴露两类硬伤:fpk 安装脚本以包用户运行无 root 权限(10237 回滚)、
# ghcr 拉镜像依赖外网。原生模式彻底去 Docker:包内自带双架构静态二进制
# (app/bin/)与前端产物(app/www/),进程以包用户直接运行。
#
# 脚本由 fnOS 框架以包用户调用,TRIM_* 环境变量由框架注入
# (TRIM_PKGVAR=应用数据目录)。生命周期约定:
#   start  exit 0=成功 / 1=失败
#   stop   exit 0=成功 / 1=失败
#   status exit 0=运行中 / 3=未运行
# (结构对齐 fnpack create 官方原生模板)

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
WATCHDOG_PID_FILE="${TRIM_PKGVAR}/.watchdog_pid"

# 按架构选二进制(build-native.sh 产出的静态链接文件)
ARCH="$(uname -m)"
case "$ARCH" in
  x86_64)          BIN="$APP_ROOT/target/bin/pigeonbox-linux-amd64" ;;
  aarch64|arm64)   BIN="$APP_ROOT/target/bin/pigeonbox-linux-arm64" ;;
  *)
    echo "unsupported arch: $ARCH" >> "${LOG_FILE}" 2>/dev/null || true
    exit 1
    ;;
esac

# p2pc 设备直传随包(2026-10-14 P2b):按架构指给 supervisor;包内无此文件时
# 指向不存在路径,core 探测失败优雅降级(直传页显示引导态)。
case "$ARCH" in
  x86_64)          export PB_P2PC_PATH="$APP_ROOT/target/bin/p2pc-linux-amd64" ;;
  aarch64|arm64)   export PB_P2PC_PATH="$APP_ROOT/target/bin/p2pc-linux-arm64" ;;
esac

# p2pcweb(PigeonBeam 信鸽直传网页客户端,2026-10-16 A2 内嵌):LAN 暴露 +
# 持久令牌门禁(--token-file 落数据卷,由 p2pcweb 自持读写,跨重启/升级稳定)。
# 端口 PB_P2PCWEB_PORT(.env 可覆盖,默认 12348);接收目录=数据卷(文件管理器
# 可见,投递到柜与柜同机零拷贝路径最短)。包内无此二进制时优雅跳过。
P2PCWEB_BIN=""
case "$ARCH" in
  x86_64)          P2PCWEB_BIN="$APP_ROOT/target/bin/p2pcweb-linux-amd64" ;;
  aarch64|arm64)   P2PCWEB_BIN="$APP_ROOT/target/bin/p2pcweb-linux-arm64" ;;
esac
P2PCWEB_PID_FILE="${TRIM_PKGVAR}/p2pcweb.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null || true
}

# 运行环境准备:在当前 shell 内导出(勿经命令替换子壳——export 传不出子壳)。
# 三个路径 env 全部落 TRIM_PKGVAR(包内 config.yaml 的 /app/data 只是占位默认,
# env 优先级高于 yaml,fpk 运行时恒被覆盖)。
prepare_env() {
    export PB_DATA_PATH="${TRIM_PKGVAR}/data"
    export PB_DATABASE_DB_NAME="${TRIM_PKGVAR}/data/fileCodeBox.db"
    export PB_STORAGE_PATH="${TRIM_PKGVAR}/data/uploads"
    export PB_SERVER_HOST=0.0.0.0
    # 端口优先级=框架注入 > .env > 12345 默认——勿无条件覆盖,否则向导改端口永远不生效。
    # 先记住框架注入值:.env 由向导生成,端口留空时会写 PB_SERVER_PORT="",下方 source
    # 会把注入值/默认值一并覆盖成空串(真机 10-13 实锤:server 侧空串按缺省监听 12345
    # 无感,但看门狗 curl http://127.0.0.1:/ping 恒失败 → 每 90s 强杀重启循环),
    # 故须在 source 之后按 注入值 > 12345 回退。
    local framework_port="${PB_SERVER_PORT:-}"
    # 统一网关 socket(fnOS 原生环境自动启用):进程监听 ${TRIM_APPDEST}/app.sock,
    # 框架网关校验 NAS 登录态后转发并注入用户头——SSO 免登录/授权目录联动的前提。
    if [ -n "${TRIM_APPDEST:-}" ]; then
        export PB_GATEWAY_SOCKET="${TRIM_APPDEST}/app.sock"
    fi
    # 向导凭证(install/config_callback 写入,优先数据卷、回退包根);
    # 缺省时 adapter 降级模式+JWT 自动生成
    local env_file=""
    if [ -r "${TRIM_PKGVAR}/.env" ]; then
        env_file="${TRIM_PKGVAR}/.env"
    elif [ -r "${APP_ROOT}/.env" ]; then
        env_file="${APP_ROOT}/.env"
    fi
    if [ -n "$env_file" ]; then
        set -a
        # shellcheck disable=SC1090
        . "$env_file"
        set +a
    fi
    # .env 空串回退(source 可能已把 PB_SERVER_PORT 覆盖为 "",看门狗拼 URL 会炸)
    if [ -z "${PB_SERVER_PORT:-}" ]; then
        export PB_SERVER_PORT="${framework_port:-12345}"
    fi
    # 首启逃逸门(2026-10-22 全生态统一): 未设管理员密码时不播种弱口令
    # admin/admin123, 改走 /setup 首启向导(浏览器里建号)。
    # 为什么必须在这里:fnos 的 server.mode=release ⇒ core 的生产门禁生效,
    # 「库中无 admin + 无 PB_ADMIN_PASSWORD」会直接 ErrInsecureDefaultAdmin
    # 拒启(应用起不来)。而向导文案说的是「留空=默认密码 admin123」——
    # 用户照做留空 → 进程直接退出,装完起不来(2026-10-22 审计 F2)。
    # 与 compose 入口脚本 / qnap pigeonbox.sh / openwrt init 同款条件。
    if [ -z "${PB_ADMIN_PASSWORD:-}" ] && [ "${PB_DISABLE_DEFAULT_ADMIN:-}" != "true" ]; then
        export PB_DISABLE_DEFAULT_ADMIN=true
        log_msg "no PB_ADMIN_PASSWORD set: switched to /setup first-run wizard mode (open the site to create the admin)"
    fi
    mkdir -p "${PB_DATA_PATH}"
}

# 管理员密码重置(.admin_reset 标记由 install/config_callback 在密码字段非空时创建):
# 删除 users 表 admin 行——core 启动语义为「库中无管理员时按 PB_ADMIN_PASSWORD 重建」,
# 故随后的进程启动即以向导/配置面板提交的新密码完成重置。
# python3(fnOS 系统自带)+标准库 sqlite3,无第三方依赖;失败保留标记并记日志(下次启动重试)。
reset_admin_if_requested() {
    [ -f "${TRIM_PKGVAR}/.admin_reset" ] || return 0
    if [ -z "${PB_ADMIN_PASSWORD:-}" ]; then
        log_msg "admin reset requested but PB_ADMIN_PASSWORD empty; keep marker"
        return 0
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        log_msg "admin reset skipped: python3 not found; keep marker"
        return 0
    fi
    if PB_DB="${PB_DATABASE_DB_NAME}" PB_PWD_HASH="$(printf '%s' "${PB_ADMIN_PASSWORD}" | sha256sum | cut -d' ' -f1)" \
        python3 - <<'PYEOF'
import os, sqlite3, datetime
db = os.environ["PB_DB"]
con = sqlite3.connect(db)
cur = con.cursor()
cur.execute("DELETE FROM users WHERE username = 'admin'")
con.commit()
left = cur.execute("SELECT COUNT(*) FROM users WHERE username = 'admin'").fetchone()[0]
with open(os.path.join(os.path.dirname(db), ".admin_reset.log"), "a") as f:
    f.write(f"{datetime.datetime.now().isoformat()} admin deleted (remaining={left})\n")
con.close()
PYEOF
    then
        rm -f "${TRIM_PKGVAR}/.admin_reset"
        log_msg "admin user removed; will be recreated from PB_ADMIN_PASSWORD on startup"
        # 消费后清空 .env 中的明文密码(避免长期留存)。注意只清文件、不清 export——
        # 紧随其后的 server 启动仍需该 env 完成 admin 重建;下次启动时密码已入库,空 env 无碍。
        local ef=""
        if [ -r "${TRIM_PKGVAR}/.env" ]; then ef="${TRIM_PKGVAR}/.env"; elif [ -r "${APP_ROOT}/.env" ]; then ef="${APP_ROOT}/.env"; fi
        if [ -n "$ef" ] && [ -w "$ef" ]; then
            sed -i 's/^PB_ADMIN_PASSWORD=.*/PB_ADMIN_PASSWORD=""/' "$ef"
        fi
    else
        log_msg "admin reset SQL failed; keep marker for next start"
    fi
}

# p2pcweb 生命周期(A2 内嵌):start 在 server 健康后拉起,stop 在 server 之前
# 停(先停依赖方再停被依赖方);看门狗顺带自愈。二进制缺失=优雅跳过(老包升级
# 首启时 target/bin 尚无 p2pcweb,不影响主服务)。
start_p2pcweb() {
    [ -n "$P2PCWEB_BIN" ] && [ -f "$P2PCWEB_BIN" ] || { log_msg "p2pcweb binary missing, skip"; return 0; }
    if check_process "$(cat "${P2PCWEB_PID_FILE}" 2>/dev/null)"; then
        return 0
    fi
    chmod +x "$P2PCWEB_BIN" 2>/dev/null || true
    local beam_port="${PB_P2PCWEB_PORT:-12348}"
    log_msg "Starting p2pcweb on 0.0.0.0:${beam_port} ..."
    # ⚠️ 必须显式给 **--config-file**：p2pcweb 的配置默认落 os.UserConfigDir()
    #   （XDG_CONFIG_HOME 或 $HOME/.config）⇒ fnOS 上它以**包用户**跑而 HOME 继承自
    #   root ⇒ 配置落到 /root/.config ⇒ **包用户写不了**
    #   ⇒ 用户在 UI 里填的 Box 地址/Key 存不住（保存失败: 配置路径不可用）。
    #   ⇒ 落数据卷：可写 + 跨重启稳定（与 --token-file / --out 同一卷）。
    "$P2PCWEB_BIN" --addr "0.0.0.0:${beam_port}" \
        --token-file "${PB_DATA_PATH}/.p2pcweb_token" \
        --config-file "${PB_DATA_PATH}/p2pcweb.json" \
        --out "${PB_DATA_PATH}" \
        --no-open >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${P2PCWEB_PID_FILE}"
}

# PigeonBeam 出厂预接线（roadmap §3.1 的真实缺口）：把 Box 地址 + 一把专用
# API Key 预置进 p2pcweb ⇒ 用户打开 Beam 的「文件柜」tab **不再需要手填**。
# 失败**不阻断**（优雅降级）：Beam 退化为「手填」旧行为，Box 照常可用。
prewire_beam_box() {
    local script="${APP_ROOT}/cmd/prewire_beam_box"
    if [ ! -f "$script" ]; then
        log_msg "beam prewire: script missing (${script}), skip"
        return 0
    fi
    # 等 p2pcweb 写出令牌文件（它自持写入，首启可能慢一拍）
    local waited=0
    while [ ! -s "${PB_DATA_PATH}/.p2pcweb_token" ] && [ "$waited" -lt 10 ]; do
        sleep 1
        waited=$((waited + 1))
    done
    local out
    out="$(bash "$script" 2>&1)"
    if [ -n "$out" ]; then
        log_msg "beam prewire: $(printf '%s' "$out" | tr '\n' ' ')"
    fi
    return 0
}

stop_p2pcweb() {
    [ -f "${P2PCWEB_PID_FILE}" ] || return 0
    local pid
    pid=$(head -n 1 "${P2PCWEB_PID_FILE}" | tr -d '[:space:]')
    if check_process "${pid}"; then
        kill -TERM "${pid}" 2>/dev/null || true
        local count=0
        while check_process "${pid}" && [ $count -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        check_process "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
        log_msg "p2pcweb stopped (${pid})"
    fi
    rm -f "${P2PCWEB_PID_FILE}"
}

# app.log 轮转:超 10MB 截尾保留最近 1MB(hertz 路由 debug 日志较肥,防无限增长)。
rotate_log() {
    [ -f "${LOG_FILE}" ] || return 0
    local size
    size=$(stat -c%s "${LOG_FILE}" 2>/dev/null || stat -f%z "${LOG_FILE}" 2>/dev/null || echo 0)
    if [ "${size}" -gt 10485760 ]; then
        tail -c 1048576 "${LOG_FILE}" > "${LOG_FILE}.tmp" 2>/dev/null \
            && mv "${LOG_FILE}.tmp" "${LOG_FILE}"
    fi
}

# 看门狗自愈循环(由 start_process 后台拉起,继承环境):
#   每 30s 探测 /ping;连续 3 次失败=无响应,重启 server 进程;
#   server 进程消失(崩溃/被杀)则直接重新拉起。
# 终止条件:server 进程不在且 watchdog 被 stop 清理——框架 stop_process
# 会先杀 watchdog 再杀 server,故不会与正常停机竞态。
# ⚠ 双胞胎警示:本脚本与 qnap 仓 shared/pigeonbox.sh 的看门狗/健康探测/日志
# 截尾逻辑同构(方言差异:本侧 bash、彼侧 POSIX sh)。单侧修改 watchdog 阈值/
# 探活方式/截尾上限时,请评估另一侧是否需要同步(共享库下沉已评估暂缓:
# 需动两仓打包布局+双真机重验,收益不匹配两份 ~40 行副本)。
watchdog_loop() {
    local failures=0 server_pid
    while true; do
        sleep 30
        # p2pcweb 自愈:进程消失(崩溃/被杀)即重新拉起(环境沿用本循环继承的导出)
        if [ -n "$P2PCWEB_BIN" ] && [ -f "$P2PCWEB_BIN" ] && [ -f "${P2PCWEB_PID_FILE}" ]; then
            local beam_pid
            beam_pid=$(cat "${P2PCWEB_PID_FILE}" 2>/dev/null)
            if ! kill -0 "${beam_pid}" 2>/dev/null; then
                log_msg "watchdog: p2pcweb process gone, respawning"
                start_p2pcweb
            fi
        fi
        server_pid=$(cat "${PID_FILE}" 2>/dev/null)
        if ! kill -0 "${server_pid}" 2>/dev/null; then
            log_msg "watchdog: server process gone, respawning"
            chmod +x "$BIN" 2>/dev/null || true
            "$BIN" --config "$APP_ROOT/target/configs/config.yaml" \
                --static "$APP_ROOT/target/www" >> "${LOG_FILE}" 2>&1 &
            echo $! > "${PID_FILE}"
            failures=0
            continue
        fi
        if curl -s -m 3 "http://127.0.0.1:${PB_SERVER_PORT}/ping" 2>/dev/null | grep -q pong; then
            failures=0
            continue
        fi
        failures=$((failures + 1))
        log_msg "watchdog: ping fail (${failures}/3)"
        if [ $failures -ge 3 ]; then
            log_msg "watchdog: no response, restarting server process"
            kill -TERM "${server_pid}" 2>/dev/null || true
            sleep 3
            kill -KILL "${server_pid}" 2>/dev/null || true
            chmod +x "$BIN" 2>/dev/null || true
            "$BIN" --config "$APP_ROOT/target/configs/config.yaml" \
                --static "$APP_ROOT/target/www" >> "${LOG_FILE}" 2>&1 &
            echo $! > "${PID_FILE}"
            failures=0
        fi
    done
}

start_watchdog() {
    # 幂等:先清旧看门狗
    if [ -f "${WATCHDOG_PID_FILE}" ]; then
        kill "$(head -n 1 "${WATCHDOG_PID_FILE}" 2>/dev/null)" 2>/dev/null || true
        rm -f "${WATCHDOG_PID_FILE}"
    fi
    watchdog_loop &
    echo $! > "${WATCHDOG_PID_FILE}"
    log_msg "watchdog started (pid $(cat "${WATCHDOG_PID_FILE}"))"
}

start_process() {
    if status; then
        return 0
    fi
    # fnpack 打包不保证保留执行位,启动前兜底(文件属包用户,chmod 可行)
    chmod +x "$BIN" 2>/dev/null || true
    if [ ! -x "$BIN" ]; then
        log_msg "binary not executable: $BIN"
        return 1
    fi
    rotate_log
    prepare_env
    reset_admin_if_requested
    log_msg "Starting process (${ARCH}) on port ${PB_SERVER_PORT} ..."
    "$BIN" --config "$APP_ROOT/target/configs/config.yaml" \
        --static "$APP_ROOT/target/www" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    # 启动健康等待:最多 10s 探测 /ping,未就绪记日志(appcenter 会以 status 复核)
    local waited=0
    while [ $waited -lt 10 ]; do
        if curl -s -m 2 "http://127.0.0.1:${PB_SERVER_PORT}/ping" 2>/dev/null | grep -q pong; then
            log_msg "health check ok after ${waited}s"
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done
    [ $waited -ge 10 ] && log_msg "warn: /ping not ready after ${waited}s (process may still be migrating)"
    # 看门狗自愈:崩溃自动拉起/无响应自动重启(框架 stop 时先行清理,无停机竞态)
    start_watchdog
    # PigeonBeam 网页客户端随主服务拉起(A2;失败不阻断主服务)
    start_p2pcweb
    # 出厂预接线:Box 地址 + 专用 API Key 预置给 Beam（失败不阻断）
    prewire_beam_box
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    # 先停看门狗,防止停机过程中被自愈逻辑重新拉起
    if [ -f "${WATCHDOG_PID_FILE}" ]; then
        wdpid=$(head -n 1 "${WATCHDOG_PID_FILE}" 2>/dev/null | tr -d '[:space:]')
        kill "${wdpid}" 2>/dev/null || true
        rm -f "${WATCHDOG_PID_FILE}"
        log_msg "watchdog stopped (${wdpid})"
    fi
    # 再停 p2pcweb(避免看门狗复活它)
    stop_p2pcweb
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file (process gone)"
            return 0
        fi
        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1 || true
        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done
        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1 || true
            sleep 1
        fi
        rm -f "${PID_FILE}"
    fi
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    fi
    return 1
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
